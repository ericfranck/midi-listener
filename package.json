{
  "name": "midi-listener",
  "version": "1.0.0",
  "description": "MIDI bridge for browser visualization",
  "main": "midi-bridge.js",
  "scripts": {
    "start": "node midi-bridge.js",
    "build": "tsc",
    "bundle": "esbuild src/app.ts --bundle --outfile=public/app.bundle.js --platform=browser --format=iife --sourcemap",
    "bundle:watch": "esbuild src/app.ts --bundle --outfile=public/app.bundle.js --platform=browser --format=iife --sourcemap --watch",
    "watch": "tsc -w",
    "dev": "concurrently \"npm run bundle:watch\" \"npm run start\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "easymidi": "^2.1.0",
    "pixi.js": "^7.4.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pixi.js": "^4.8.9",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
